    {
      "parameters": {
        "jsCode": "const item = $input.first();\n\nconst b64 = item.json.data?.[0]?.b64_json;\n\nif (!b64) {\n  throw new Error('No b64_json image found in the previous node output.');\n}\n\nreturn [\n  {\n    json: {\n      fileName: 'generated-ad.png',\n      mimeType: 'image/png',\n    },\n    binary: {\n      data: {\n        data: b64,\n        mimeType: 'image/png',\n        fileName: 'generated-ad.png',\n        fileExtension: 'png',\n      },\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
